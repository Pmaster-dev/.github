{
  "$schema": "http://json-schema.org/draft-07/schema#",
  "title": "MBTQ Audit Schemas",
  "type": "object",
  "definitions": {
    "SourceInventory": {
      "type": "object",
      "required": ["inventory"],
      "additionalProperties": false,
      "properties": {
        "inventory": {
          "type": "array",
          "items": {
            "type": "object",
            "required": [
              "id",
              "type",
              "repository",
              "branch",
              "path",
              "language",
              "format",
              "component",
              "domain",
              "status",
              "source_url",
              "related_files",
              "evidence"
            ],
            "additionalProperties": false,
            "properties": {
              "id": { "type": "string" },
              "type": {
                "type": "string",
                "enum": [
                  "source",
                  "documentation",
                  "architecture",
                  "configuration",
                  "deployment",
                  "schema",
                  "API",
                  "workflow",
                  "script",
                  "prompt",
                  "contract",
                  "specification",
                  "test",
                  "asset",
                  "generated",
                  "unknown"
                ]
              },
              "repository": { "type": "string" },
              "branch": { "type": "string" },
              "path": { "type": "string" },
              "language": { "type": "string" },
              "format": { "type": "string" },
              "component": { "type": "string" },
              "domain": { "type": "string" },
              "status": {
                "type": "string",
                "enum": ["FOUND", "DERIVED", "INFERRED", "CURRENT", "HISTORICAL", "EXPERIMENTAL", "UNKNOWN"]
              },
              "source_url": { "type": "string", "format": "uri" },
              "related_files": {
                "type": "array",
                "items": { "type": "string" }
              },
              "evidence": { "type": "string" }
            }
          }
        }
      }
    },
    "ComponentRegistry": {
      "type": "object",
      "required": ["registry"],
      "additionalProperties": false,
      "properties": {
        "registry": {
          "type": "array",
          "items": {
            "type": "object",
            "required": ["component"],
            "additionalProperties": false,
            "properties": {
              "component": {
                "type": "object",
                "required": [
                  "canonical_name",
                  "aliases",
                  "definitions",
                  "dependencies",
                  "consumers",
                  "providers",
                  "APIs",
                  "data_stores",
                  "authentication",
                  "deployment_target",
                  "current_evidence",
                  "historical_evidence",
                  "confidence"
                ],
                "additionalProperties": false,
                "properties": {
                  "canonical_name": { "type": "string" },
                  "aliases": {
                    "type": "array",
                    "items": { "type": "string" }
                  },
                  "definitions": {
                    "type": "array",
                    "items": {
                      "type": "object",
                      "required": ["repository", "path", "purpose", "evidence"],
                      "additionalProperties": false,
                      "properties": {
                        "repository": { "type": "string" },
                        "path": { "type": "string" },
                        "purpose": { "type": "string" },
                        "evidence": { "type": "string" }
                      }
                    }
                  },
                  "dependencies": {
                    "type": "array",
                    "items": { "type": "string" }
                  },
                  "consumers": {
                    "type": "array",
                    "items": { "type": "string" }
                  },
                  "providers": {
                    "type": "array",
                    "items": { "type": "string" }
                  },
                  "APIs": {
                    "type": "array",
                    "items": { "type": "string" }
                  },
                  "data_stores": {
                    "type": "array",
                    "items": { "type": "string" }
                  },
                  "authentication": { "type": "string" },
                  "deployment_target": { "type": "string" },
                  "current_evidence": { "type": "string" },
                  "historical_evidence": { "type": "string" },
                  "confidence": { "type": "number", "minimum": 0, "maximum": 1 }
                }
              }
            }
          }
        }
      }
    }
  }
}
